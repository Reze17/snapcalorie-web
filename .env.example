# Postgres connection string. Matches docker-compose.yml's postgres service.
DATABASE_URL=postgresql://snapcalorie:snapcalorie@localhost:5432/snapcalorie

# Auth (Auth.js / NextAuth v5). Generate AUTH_SECRET with: npx auth secret
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Vision provider (meal photo detection) — see CLAUDE.md provider decoupling notes.
# mock (default, no key needed) | anthropic (real Claude vision, needs VISION_API_KEY)
VISION_PROVIDER=mock
# Anthropic API key (https://console.anthropic.com/settings/keys), only needed
# when VISION_PROVIDER=anthropic. ANTHROPIC_API_KEY also works as a fallback.
VISION_API_KEY=
# Model override for the anthropic provider. Defaults to claude-sonnet-5.
VISION_ANTHROPIC_MODEL=
# Mock-only dev/QA overrides: default | lowConfidence | singleItem | empty | timeout
VISION_MOCK_SCENARIO=
VISION_MOCK_LATENCY_MS=

# Nutrition data provider (calorie/macro lookups)
NUTRITION_PROVIDER=mock
NUTRITION_API_KEY=

# S3-compatible object storage for uploaded meal photos. Matches
# docker-compose.yml's minio service for local dev; leave S3_ENDPOINT unset
# to point at real AWS S3 in other environments.
S3_BUCKET=snapcalorie-meals
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=snapcalorie
S3_SECRET_ACCESS_KEY=snapcalorie123
S3_ENDPOINT=http://localhost:9000

# Phase 10 (NFR hardening) — all optional, the app runs correctly with none set.

# Comma-separated email allowlist for the internal /admin/metrics page
# (latency percentiles, the two FR-10 release metrics). Unset = nobody can
# reach it (404, not a login redirect — see CLAUDE.md).
ADMIN_EMAILS=

# Error tracking (@sentry/nextjs). Both no-op with no DSN set — no Sentry
# account is required for the app to build/run correctly.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
